---
import { Image } from 'astro:assets';
import type { Project } from '../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, tagline, description, media, primaryLink, links = [] } = project;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const destinationId = `project-${slug}-destination`;
---

<article class="project">
  <h3 class="project__title">
    <a
      href={primaryLink.href}
      aria-describedby={destinationId}
      {...isExternal(primaryLink.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
    >
      <span class="project__slash" aria-hidden="true">/</span>{name}{
        isExternal(primaryLink.href) && (
          <span class="project__external" aria-hidden="true">
            ↗
          </span>
        )
      }
    </a>
  </h3>
  <span id={destinationId} class="visually-hidden">
    {primaryLink.label}{isExternal(primaryLink.href) && ', opens in a new tab'}
  </span>
  <p class="project__tagline">{tagline}</p>

  <div class:list={['project__media', `project__media--${media.kind}`]}>
    {
      media.kind === 'screenshot' ? (
        <Image
          src={media.src}
          alt=""
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 48rem) 50vw, 100vw"
        />
      ) : (
        <Image src={media.src} alt="" width={240} height={240} densities={[1, 2]} />
      )
    }
  </div>

  <p class="project__description">{description}</p>

  {
    links.length > 0 && (
      <ul class="project__links">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              {...(isExternal(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
              {isExternal(link.href) && (
                <>
                  <span class="visually-hidden"> (opens in new tab)</span>
                  <span aria-hidden="true">↗</span>
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .project__title {
    font-size: var(--text-title);
    /* The reference title stems measure ≈0.125em, Geist SemiBold rather than Medium. */
    font-weight: var(--weight-semibold);
    line-height: 1.1;
    letter-spacing: var(--tracking-title);
  }

  .project__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .project__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.12em;
  }

  .project__slash {
    margin-inline-end: 0.02em;
  }

  .project__external {
    display: inline-block;
    margin-inline-start: 0.2em;
    font-size: 0.55em;
    vertical-align: 0.6em;
    color: var(--color-text-muted);
  }

  .project__tagline {
    margin-block-start: var(--space-4);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.375rem);
    line-height: 1.3;
  }

  .project__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin-block-start: clamp(var(--space-6), 2.7vw, var(--space-12));
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-media);
  }

  .project__media img {
    display: block;
  }

  .project__media--screenshot img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Stand-in: the square app icon, centered at 36% of the frame height
     (22.5% of its width in the 16:10 frame). */
  .project__media--logo img {
    inline-size: 22.5%;
    block-size: auto;
    aspect-ratio: 1;
    border-radius: 22%;
  }

  .project__description {
    max-inline-size: var(--measure);
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .project__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    min-block-size: 2.75rem;
  }
</style>
