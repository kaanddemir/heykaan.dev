---
import { Image } from 'astro:assets';
import type { Extension } from '../types/project';

interface Props {
  extension: Extension;
}

const { extension } = Astro.props;
const { name, tagline, description, icon, primaryLink, links } = extension;
---

<article class="extension">
  <Image class="extension__icon" src={icon} alt="" width={64} height={64} densities={[1, 2]} />
  <div class="extension__body">
    <h3 class="extension__title">
      <a href={primaryLink.href}>
        <span class="extension__slash" aria-hidden="true">/</span>{name}
      </a>
    </h3>
    <p class="extension__tagline">{tagline}</p>
    <p class="extension__description">{description}</p>
    <ul class="extension__links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${name} on ${link.label}, opens in a new tab`}
            >
              {link.label}
              <span class="extension__external" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  /*
   * Compact, text-first entry. A hairline divider separates entries; the
   * icon moves beside the text once the entry itself is wide enough.
   */
  .extension {
    container-type: inline-size;
    display: grid;
    gap: var(--space-6);
    align-content: start;
    padding-block-start: var(--space-8);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .extension__icon {
    inline-size: clamp(3rem, 2.5rem + 1.5vw, 4rem);
    block-size: auto;
    aspect-ratio: 1;
    border-radius: 22%;
  }

  @container (min-width: 22rem) {
    .extension__body {
      grid-row: 1;
      grid-column: 2;
    }
  }

  .extension__body {
    min-inline-size: 0;
  }

  /* Title and tagline follow the Featured Projects item typography. */
  .extension__title {
    font-size: var(--text-title);
    font-weight: var(--weight-semibold);
    line-height: 1.1;
    letter-spacing: var(--tracking-title);
  }

  .extension__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .extension__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.12em;
  }

  .extension__slash {
    margin-inline-end: 0.02em;
  }

  .extension__tagline {
    margin-block-start: var(--space-4);
    font-size: var(--text-tagline);
    line-height: 1.3;
  }

  .extension__description {
    max-inline-size: var(--measure);
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }

  .extension__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(var(--space-4), 3vw, var(--space-6));
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .extension__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    min-block-size: 2.75rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .extension__links a:hover {
    text-decoration: underline;
  }

  .extension__external {
    font-size: 0.85em;
    color: var(--color-text-muted);
  }
</style>
