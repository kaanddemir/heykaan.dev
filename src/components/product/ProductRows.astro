---
import type { ProductRow } from '../../types/product';

interface Props {
  rows: ProductRow[];
  /** Steps are an ordered list with visible numbers. */
  numbered?: boolean;
}

const { rows, numbered = false } = Astro.props;
const List = numbered ? 'ol' : 'ul';
---

<List class:list={['rows', { 'rows--numbered': numbered }]}>
  {
    rows.map((row, i) => (
      <li class="rows__item">
        {numbered && (
          <span class="rows__number" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        <h3 class="rows__title">{row.title}</h3>
        <p class="rows__description">
          {row.description}
          {row.link && (
            <>
              {' '}
              <a href={row.link.href} target="_blank" rel="noopener noreferrer">
                {row.link.label}
                <span class="visually-hidden">, opens in a new tab</span>
                <span aria-hidden="true"> ↗</span>
              </a>
            </>
          )}
        </p>
      </li>
    ))
  }
</List>

<style>
  /* Same hairline rows as the About skills list: narrow label, wide content. */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .rows__item {
    display: grid;
    gap: var(--space-2) var(--gutter);
    padding-block: clamp(var(--space-6), 2.5vw, var(--space-8));
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .rows__number {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .rows__title {
    font-size: var(--text-tagline);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-title);
  }

  .rows__description {
    max-inline-size: 60ch;
    font-size: var(--text-description);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }

  .rows__description a {
    display: inline-block;
    min-block-size: 1.5rem;
    color: var(--color-text);
  }

  @media (min-width: 64rem) {
    .rows__item {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: baseline;
    }

    /* Numbered rows: the number takes the label column, title and text the wide one. */
    .rows--numbered .rows__item {
      grid-template-rows: auto auto;
    }

    .rows--numbered .rows__number {
      grid-row: 1 / span 2;
    }

    .rows--numbered .rows__title,
    .rows--numbered .rows__description {
      grid-column: 2;
    }
  }
</style>
