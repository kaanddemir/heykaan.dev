---
// Cycles System → Light → Dark. The label for the current mode is chosen in
// CSS from <html data-theme-mode>, which the inline bootstrap sets before
// first paint, so the right label shows without waiting for this script.
---

<button type="button" class="theme-toggle" data-theme-toggle>
  <span class="visually-hidden">Theme: </span>
  <span class="theme-toggle__state" data-mode="system">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8" />
      <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />
    </svg>
    System
  </span>
  <span class="theme-toggle__state" data-mode="light">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="4" />
      <path
        d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
      />
    </svg>
    Light
  </span>
  <span class="theme-toggle__state" data-mode="dark">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
    </svg>
    Dark
  </span>
</button>
<span class="visually-hidden" aria-live="polite" data-theme-status></span>

<script>
  import { getMode, nextMode, setMode } from '../scripts/theme';

  const labels = { system: 'System', light: 'Light', dark: 'Dark' } as const;
  const status = document.querySelector<HTMLElement>('[data-theme-status]');

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const mode = nextMode(getMode());
      setMode(mode);
      if (status) status.textContent = `Theme set to ${labels[mode]}`;
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: inherit;
    line-height: var(--leading-snug);
  }

  .theme-toggle__state {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  .theme-toggle:hover .theme-toggle__state {
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: 0.2em;
  }

  svg {
    inline-size: 1.125em;
    block-size: 1.125em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  :global(html[data-theme-mode='system']) [data-mode='system'],
  :global(html[data-theme-mode='light']) [data-mode='light'],
  :global(html[data-theme-mode='dark']) [data-mode='dark'] {
    display: inline-flex;
  }

  /* Without the bootstrap script the control cannot work, so it stays hidden. */
  :global(html:not([data-theme-mode])) .theme-toggle {
    display: none;
  }
</style>
