---
import SectionHeading from '../SectionHeading.astro';
import { site } from '../../data/site';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container">
    <!-- "Get in touch" was the legacy contact panel title. "G" ≈0.042em, italic "t" ≈0.074em bearing. -->
    <SectionHeading
      id="contact-title"
      first="Get in"
      second="touch"
      firstBearing={0.042}
      secondBearing={0.074}
    />

    <div class="contact__body">
      <p class="contact__label">Email</p>
      <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>

      <ul class="contact__social">
        {
          site.social.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.label}, opens in a new tab`}
              >
                {link.label}
                <span class="contact__external" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    margin-block-start: var(--space-section);
  }

  .contact__body {
    margin-block-start: clamp(var(--space-12), 5vw, 6rem);
  }

  .contact__label {
    color: var(--color-text-muted);
  }

  /* Primary contact, sized so the full address fits between the gutters
     (≈11.2em wide in Geist Medium). */
  .contact__email {
    display: inline-block;
    margin-block-start: var(--space-2);
    /* "h" carries ≈0.075em left bearing in Geist Medium; align the ink to the gutter. */
    margin-inline-start: -0.075em;
    font-size: clamp(1.25rem, 7.2vw, 9rem);
    font-weight: var(--weight-medium);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact__email:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.04em;
    text-underline-offset: 0.12em;
  }

  .contact__social {
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(var(--space-6), 3vw, var(--space-12));
    margin: clamp(var(--space-8), 4vw, var(--space-16)) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-tagline);
  }

  .contact__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    min-block-size: 2.75rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .contact__social a:hover {
    text-decoration: underline;
  }

  .contact__external {
    font-size: 0.8em;
    color: var(--color-text-muted);
  }
</style>
