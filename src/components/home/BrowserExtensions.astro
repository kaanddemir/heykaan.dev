---
import SectionHeading from '../SectionHeading.astro';
import ExtensionItem from '../ExtensionItem.astro';
import { extensions } from '../../data/extensions';
---

<section id="extensions" class="browser-extensions" aria-labelledby="extensions-title">
  <div class="container">
    <SectionHeading id="extensions-title" first="Browser" second="Extensions" />
    <div class="browser-extensions__grid">
      {extensions.map((extension) => <ExtensionItem extension={extension} />)}
    </div>
  </div>
</section>

<style>
  /* Same section rhythm as Featured Projects (margin keeps #extensions landing at the heading). */
  .browser-extensions {
    margin-block-start: var(--space-section);
  }

  .browser-extensions__grid {
    display: grid;
    gap: clamp(var(--space-12), 5vw, var(--space-24)) var(--gutter);
    margin-block-start: clamp(var(--space-12), 5vw, 6rem);
  }

  @media (min-width: 64rem) {
    .browser-extensions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
