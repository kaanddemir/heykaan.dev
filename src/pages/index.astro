---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import BrowserExtensions from '../components/home/BrowserExtensions.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
---

<BaseLayout noindex>
  <SiteHeader />
  <main id="main">
    <Hero caption={site.heroCaption} />
    <FeaturedProjects />
    <BrowserExtensions />
    <About />
    <Contact />
  </main>
  <SiteFooter />
</BaseLayout>
