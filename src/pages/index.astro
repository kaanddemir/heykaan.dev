---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
---

<BaseLayout noindex>
  <SiteHeader />
  <main id="main">
    <Hero />
    <FeaturedProjects />
    <!--
      Temporary anchor targets for the header navigation, replaced by the
      About and Contact sections in later phases.
    -->
    <div id="about"></div>
    <div id="contact"></div>
  </main>
</BaseLayout>
